# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser commitado.

DB_USERNAME=ecko
DB_PASSWORD=sua_senha
DB_HOSTNAME=localhost
DB_NAME=ranking

# Versão que o servidor anuncia. Diferente da versão do cliente = cliente baixa /download_update.
APP_VERSION=1.0.1

# 1 liga o modo debug do Flask. NUNCA use 1 em produção.
FLASK_DEBUG=0

# Folga, em segundos, entre o tempo real da partida e o score aceito.
# RUN_TOLERANCE_SECONDS=5

# Caminhos opcionais (relativos à raiz do projeto)
# INSTANCE_DIR=instance
# BUILD_PATH=builds/Space Survivors.exe
# LOG_PATH=erros.log
